{
  "name": "vue-fetch",
  "version": "3.1.0-1",
  "description": "Simplified fetch API for Vue 2+",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "prepublish": "pnpm run build",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangbang93/vue-fetch.git"
  },
  "keywords": [
    "fetch",
    "vue"
  ],
  "author": "bangbang93",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bangbang93/vue-fetch/issues"
  },
  "homepage": "https://github.com/bangbang93/vue-fetch#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@types/debug": "0.0.30",
    "debug": "^3.1.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^22.20.1",
    "release-it": "^21.0.1",
    "tsdown": "^0.21.2",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.2.45"
  },
  "peerDependencies": {
    "vue": "^3.2.45"
  }
}
